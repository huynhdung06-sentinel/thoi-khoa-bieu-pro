{
  "entities": {
    "FamilyAccount": {
      "title": "Family Account",
      "description": "The main family account containing parent info and settings",
      "type": "object",
      "properties": {
        "parentName": { "type": "string", "maxLength": 100 },
        "parentPin": { "type": "string", "maxLength": 8 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["parentName", "parentPin", "ownerId", "createdAt", "updatedAt"]
    },
    "FamilyCodeAccount": {
      "title": "Family By Code Account",
      "description": "Cloud-synced family account indexed by family code for cross-device sharing",
      "type": "object",
      "properties": {
        "familyCode": { "type": "string", "maxLength": 12 },
        "parentName": { "type": "string", "maxLength": 100 },
        "parentPin": { "type": "string", "maxLength": 8 },
        "parentEmail": { "type": "string", "maxLength": 150 },
        "securityQuestion": { "type": "string", "maxLength": 200 },
        "securityAnswer": { "type": "string", "maxLength": 200 },
        "children": { "type": "array" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["familyCode", "parentName", "parentPin", "children"]
    },
    "ChildProfile": {
      "title": "Child Profile",
      "description": "Profile of a child in the family",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "grade": { "type": "number" },
        "className": { "type": "string", "maxLength": 50 },
        "avatar": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["name", "grade", "className", "avatar", "createdAt", "updatedAt"]
    },
    "ChildData": {
      "title": "Child Data",
      "description": "Storage for all child-specific data like lessons, plans, and records",
      "type": "object",
      "properties": {
        "classInfo": { "type": "object" },
        "periods": { "type": "object" },
        "timetableSlots": { "type": "object" },
        "lessons": { "type": "object" },
        "lessonPlans": { "type": "object" },
        "studyRecords": { "type": "object" },
        "documents": { "type": "object" },
        "subjects": { "type": "object" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      }
    },
    "SubAccount": {
      "title": "Sub Account",
      "description": "Child sub-account for instant QR and 2-way realtime sync",
      "type": "object",
      "properties": {
        "subId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string" },
        "childProfile": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["subId", "parentId", "role"]
    },
    "ParentAccount": {
      "title": "Parent Account",
      "description": "Parent management account for oversight",
      "type": "object",
      "properties": {
        "parentId": { "type": "string", "maxLength": 128 },
        "parentName": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["parentId"]
    }
  },
  "firestore": {
    "sub_accounts/{subId}": {
      "schema": "SubAccount",
      "description": "Stores sub-accounts for child devices"
    },
    "sub_accounts/{subId}/data/current": {
      "schema": "ChildData",
      "description": "Stores 2-way realtime state of sub-account"
    },
    "parent_accounts/{parentId}": {
      "schema": "ParentAccount",
      "description": "Stores parent account details"
    },
    "families/{familyId}": {
      "schema": "FamilyAccount",
      "description": "Stores the main family account, ID is the parent's Firebase Auth UID."
    },
    "families/{familyId}/children/{childId}": {
      "schema": "ChildProfile",
      "description": "Stores the children profiles."
    },
    "families/{familyId}/children/{childId}/data/appState": {
      "schema": "ChildData",
      "description": "Stores the entire app state for a child profile."
    },
    "families_by_code/{familyCode}": {
      "schema": "FamilyCodeAccount",
      "description": "Stores family data indexed by family code for cross-device instant sync."
    },
    "families_by_code/{familyCode}/children_data/{childId}": {
      "schema": "ChildData",
      "description": "Stores app state per child indexed by family code."
    }
  }
}
