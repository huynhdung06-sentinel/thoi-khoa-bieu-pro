rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đồng bộ dữ liệu gia đình qua Mã Gia Đình (Family Code)
    match /families_by_code/{familyCode} {
      allow read, write: if true;

      match /children_data/{childId} {
        allow read, write: if true;
      }
    }

    // Cho phép đồng bộ tài khoản con (Sub-accounts)
    match /sub_accounts/{subId} {
      allow read, write: if true;
      match /data/{document=**} {
        allow read, write: if true;
      }
    }

    // Cho phép tài khoản cha mẹ
    match /parent_accounts/{parentId} {
      allow read, write: if true;
    }

    // Cho phép tài khoản gia đình
    match /families/{familyId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
